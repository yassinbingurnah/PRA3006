# Developing query, below query selects all drugs that interact with proteins involved in wound healing, fibril organisation or ECM organization.

SELECT DISTINCT ?drugLabel ?proteinLabel ?processLabel
WHERE {
  VALUES ?goID {
    "GO:0030199"   # collagen fibril organization
    "GO:0030198"   # extracellular matrix organization
    "GO:0042060"   # wound healing
  }
  ?process wdt:P686 ?goID .               # find each of those processes
  ?protein wdt:P682 ?process .            # proteins involved in any of them

  { ?drug wdt:P129 ?protein . }           # drug recorded as interacting with protein
  UNION
  { ?protein wdt:P129 ?drug . }           # ...or protein recorded as interacting with drug

  ?drug wdt:P715 ?drugbankID .            # keep only things that have a DrugBank ID 

  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?processLabel ?drugLabel


# SPARQL ideas: 
# 1. Which proteins involved in osteoblast differentiation or ossification are already targeted by existing drugs?
# 2. which existing drugs interact with proteins involved in collagen fibril organization. how do they affect the healing process
# final choice is 2

# query whats associated with collagen type I alpha 1 chain to find out some more

SELECT ?propLabel ?valueLabel
WHERE {
  ?protein wdt:P352 "P02452" .           # find a protein with the ID p02452 (collagen in humans)
  ?protein ?p ?value .                   # what
  ?prop wikibase:directClaim ?p .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}

